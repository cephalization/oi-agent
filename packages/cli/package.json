{
  "name": "oi-agent",
  "version": "0.2.0",
  "description": "A coding agent whose entire runtime state is OpenInference spans on disk.",
  "keywords": [
    "agent",
    "cli",
    "llm",
    "openinference",
    "opentelemetry",
    "phoenix"
  ],
  "homepage": "https://github.com/cephalization/oi-agent#readme",
  "bugs": "https://github.com/cephalization/oi-agent/issues",
  "license": "MIT",
  "author": "Tony Powell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cephalization/oi-agent.git",
    "directory": "packages/cli"
  },
  "bin": {
    "oi": "./dist/oi.mjs"
  },
  "files": [
    "dist",
    "self"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/self.ts && vp pack",
    "prepack": "node ../../scripts/self.ts && vp pack && cp ../../README.md README.md && cp ../../LICENSE LICENSE"
  },
  "devDependencies": {
    "@oi-agent/engine": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
